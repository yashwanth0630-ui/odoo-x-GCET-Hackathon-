// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Role {
  id          String   @id @default(cuid())
  name        String   @unique // e.g. "INVENTORY_MANAGER", "WAREHOUSE_STAFF"
  label       String   // e.g. "Inventory Manager", "Warehouse Staff"
  description String
  permissions String   // JSON string of granular permissions
  users       User[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("roles")
}

model User {
  id                 String              @id @default(cuid())
  email              String              @unique
  passwordHash       String
  name               String
  roleId             String
  role               Role                @relation(fields: [roleId], references: [id], onDelete: Restrict)
  department         String?
  warehouseLocation  String?             // Assigned warehouse or zone
  isActive           Boolean             @default(true)
  lastLoginAt        DateTime?
  sessions           Session[]
  resetOtps          PasswordResetOtp[]
  auditLogs          AuditLog[]
  operationDocuments OperationDocument[]
  stockMovements     StockMovement[]
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  @@index([email])
  @@index([roleId])
  @@map("users")
}

model Session {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  ipAddress String?
  userAgent String?
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([token])
  @@map("sessions")
}

model PasswordResetOtp {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  otpHash   String   // Hashed 6-digit OTP code
  expiresAt DateTime
  used      Boolean  @default(false)
  attempts  Int      @default(0)
  createdAt DateTime @default(now())

  @@index([userId])
  @@map("password_reset_otps")
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action    String
  details   String?  // JSON stringified metadata
  ipAddress String?
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([action])
  @@map("audit_logs")
}

// -------------------------------------------------------------
// PRODUCT & LOCATION MANAGEMENT MODELS
// -------------------------------------------------------------

model Warehouse {
  id          String     @id @default(cuid())
  name        String     @unique // e.g. "Central Distribution Center (HQ)"
  code        String     @unique // e.g. "CDC-01"
  address     String?
  locations   Location[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@map("warehouses")
}

model Location {
  id                  String              @id @default(cuid())
  name                String              // e.g. "Rack A", "Rack B", "Bay 12", "Shelf 04"
  code                String              // e.g. "CDC-RACK-A"
  type                String              @default("STORAGE") // STORAGE, RECEIVING, DISPATCH, QUARANTINE
  warehouseId         String
  warehouse           Warehouse           @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  stockLevels         StockLevel[]
  docSourceLocations  OperationDocument[] @relation("DocSourceLocation")
  docDestLocations    OperationDocument[] @relation("DocDestLocation")
  moveSourceLocations StockMovement[]     @relation("MoveSourceLocation")
  moveDestLocations   StockMovement[]     @relation("MoveDestLocation")
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt

  @@unique([warehouseId, code])
  @@index([warehouseId])
  @@map("locations")
}

model Category {
  id          String    @id @default(cuid())
  name        String    @unique
  code        String    @unique
  description String?
  products    Product[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@map("categories")
}

model Product {
  id             String          @id @default(cuid())
  name           String
  sku            String          @unique // SKU or Code
  barcode        String?
  description    String?
  categoryId     String
  category       Category        @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  uom            String          @default("Units") // Units, Kg, Meters, Boxes, Pallets, Liters
  initialStock   Int             @default(0)
  minThreshold   Int             @default(10) // Reordering Rule: minimum threshold
  idealStock     Int             @default(50) // Reordering target
  costPrice      Float?
  sellingPrice   Float?
  stockLevels    StockLevel[]
  operationItems OperationItem[]
  stockMovements StockMovement[]
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@index([categoryId])
  @@index([sku])
  @@index([name])
  @@map("products")
}

model StockLevel {
  id         String   @id @default(cuid())
  productId  String
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  locationId String
  location   Location @relation(fields: [locationId], references: [id], onDelete: Cascade)
  quantity   Int      @default(0)
  updatedAt  DateTime @updatedAt

  @@unique([productId, locationId])
  @@index([productId])
  @@index([locationId])
  @@map("stock_levels")
}

// -------------------------------------------------------------
// TASKS 3, 4, 5: OPERATIONS & STOCK LEDGER
// -------------------------------------------------------------

model OperationDocument {
  id                    String          @id @default(cuid())
  referenceNumber       String          @unique // e.g. "WH/IN/0001", "WH/OUT/0001", "WH/INT/0001", "INV/ADJ/0001"
  type                  String          // "RECEIPT", "DELIVERY", "INTERNAL_TRANSFER", "ADJUSTMENT"
  status                String          @default("DRAFT") // "DRAFT", "WAITING", "READY", "DONE", "CANCELED"
  sourceLocationId      String?
  sourceLocation        Location?       @relation("DocSourceLocation", fields: [sourceLocationId], references: [id], onDelete: SetNull)
  destinationLocationId String?
  destinationLocation   Location?       @relation("DocDestLocation", fields: [destinationLocationId], references: [id], onDelete: SetNull)
  partnerName           String?         // Supplier (Receipts) or Customer (Deliveries)
  notes                 String?
  createdById           String?
  createdBy             User?           @relation(fields: [createdById], references: [id], onDelete: SetNull)
  validatedAt           DateTime?
  items                 OperationItem[]
  stockMovements        StockMovement[]
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt

  @@index([type])
  @@index([status])
  @@index([referenceNumber])
  @@map("operation_documents")
}

model OperationItem {
  id         String            @id @default(cuid())
  documentId String
  document   OperationDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  productId  String
  product    Product           @relation(fields: [productId], references: [id], onDelete: Restrict)
  quantity   Int
  picked     Boolean           @default(false)
  packed     Boolean           @default(false)

  @@index([documentId])
  @@index([productId])
  @@map("operation_items")
}

model StockMovement {
  id                    String             @id @default(cuid())
  reference             String             // Ledger transaction ref
  documentId            String?
  document              OperationDocument? @relation(fields: [documentId], references: [id], onDelete: SetNull)
  productId             String
  product               Product            @relation(fields: [productId], references: [id], onDelete: Restrict)
  sourceLocationId      String?
  sourceLocation        Location?          @relation("MoveSourceLocation", fields: [sourceLocationId], references: [id], onDelete: SetNull)
  destinationLocationId String?
  destinationLocation   Location?          @relation("MoveDestLocation", fields: [destinationLocationId], references: [id], onDelete: SetNull)
  quantity              Int                // Signed or absolute quantity
  type                  String             // "INCOMING", "OUTGOING", "INTERNAL", "ADJUSTMENT"
  reason                String?            // Reason / notes
  operatorId            String?
  operator              User?              @relation(fields: [operatorId], references: [id], onDelete: SetNull)
  createdAt             DateTime           @default(now())

  @@index([productId])
  @@index([documentId])
  @@index([type])
  @@index([createdAt])
  @@map("stock_movements")
}
